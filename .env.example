# divar-crawler configuration (all optional; values shown are defaults).
# The CLI reads plain environment variables; load this file yourself, e.g.
#   node --env-file=.env bin/divar-crawler.js

# SQLite file for crawl state and the sqlite output (overridden by --db).
DIVAR_DB_PATH=data/divar.sqlite
# Comma-separated Divar city ids (1 = Tehran).
DIVAR_CITY_IDS=1
# Minimum delay between requests. Divar answers HTTP 429 above ~2.5 req/s; keep >= 1000.
DIVAR_DELAY_MS=1500

HTTP_TIMEOUT_MS=20000
HTTP_MAX_RETRIES=4
# Base wait after a 429 without Retry-After (multiplied by the attempt number).
HTTP_RATE_LIMIT_BACKOFF_MS=15000

# Only required with --output=http
SINK_URL=
SINK_TOKEN=
SINK_BATCH_SIZE=25

# debug | info | warn | error | silent (logs are JSON lines on stderr)
LOG_LEVEL=info
